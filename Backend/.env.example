# ─── Base de datos PostgreSQL ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salones_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui

# ─── JWT ────────────────────────────────────────────────────
# Cambia este valor por una cadena larga y aleatoria
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_seguro
JWT_EXPIRES_IN=7d

# ─── Servidor ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Firebase (para notificaciones push) ────────────────────
# Descarga el archivo serviceAccountKey.json desde Firebase Console
# y pon la ruta aquí
FIREBASE_CREDENTIALS=./firebase-credentials.json
